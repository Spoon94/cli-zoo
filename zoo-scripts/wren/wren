#!/usr/bin/env bash
# wren - 把 statusline 装到 Claude Code 与 pi 两个宿主上。
#
# 布局:
#   行1: ~/cwd | branch ↑a↓b +增 ~删 ✱改
#   行2: ↑in ↓out R cacheR CH% CPn | ctx%/win | 模型名 · 思考等级 · 时长
#
# 本目录内三个 payload 拷出去安装:
#   wren.py    -> $PREFIX/wren-cc            并在 ~/.claude/settings.json 写入 statusLine
#   wren.ts    -> $PI_EXT_DIR/wren.ts        pi 自动加载该目录下的 .ts
#   wren-qc.py -> $QODER_CONFIG_DIR/wren-qc.py 并在 ~/.qoder/settings.json 写入 statusLine（绝对路径）
#
# 装的是副本而不是软链：装完以后不依赖本仓库是否还在原处。
#
# 用法:
#   wren install [cc|pi|all]
#   wren uninstall [cc|pi|all]
#   wren -h

set -u

CC_CMD_NAME="wren-cc"

usage() {
    cat <<'EOF'
Usage: wren <command> [target]

将本目录下的 statusline payload 装到三个宿主:

  wren.py    ->  $PREFIX/wren-cc              并在 $CLAUDE_SETTINGS 写入 statusLine
  wren.ts    ->  $PI_EXT_DIR/wren.ts          pi 自动加载该目录下的 .ts
  wren-qc.py ->  $QODER_CONFIG_DIR/wren-qc.py  并在 $QODER_SETTINGS 写入 statusLine（command 写绝对路径，与 qoder 官方引导一致）

Commands:
  install [target]     安装（幂等）。装的是文件副本，装完不依赖本仓库位置
  uninstall [target]   卸载（只删自己装的那份，被改过的不动；一并清掉自己的副产物）
  -h, --help           显示本帮助

target（省略则为 all）:
  all                  三个宿主都装（默认）
  cc                   只装 Claude Code 侧（别名 claude）
  pi                   只装 pi 侧
  qc                   只装 Qoder CLI 侧（别名 qoder）

Environment:
  PREFIX             Claude Code 侧可执行文件目录 (default: /usr/local/bin)
  PI_EXT_DIR         pi 扩展目录 (default: $HOME/.pi/agent/extensions)
  CLAUDE_SETTINGS    要改的 settings.json  (default: $CLAUDE_CONFIG_DIR/settings.json,
                     未设则 $HOME/.claude/settings.json)
  QODER_CONFIG_DIR   Qoder CLI 配置目录 (default: $HOME/.qoder；qoder 官方同名变量)
  QODER_SETTINGS     要改的 Qoder settings.json (default: $QODER_CONFIG_DIR/settings.json)

依赖:
  装 cc / qc 时需要 python3（用于合并写 settings.json）；只装 pi 时不需要。

退出码:
  0  成功
  1  写入失败（settings.json 读不懂、目标不可写等）
  2  参数错误（未知子命令、未知 target）
  3  依赖缺失（python3，或 payload 文件不存在）
EOF
}

log_err() {
    printf '%s\n' "$*" >&2
}

log_info() {
    printf '%s\n' "$*"
}

# 回溯脚本自身位置（可能被 cli-zoo-install.sh 软链到 $PREFIX），借此找到同目录的 payload。
# 只用 bash 内建与 readlink，不依赖 dirname/pwd 这些外部命令。
script_dir() {
    local f="${BASH_SOURCE[0]}" d
    while [[ -L "$f" ]]; do
        d="$(cd "${f%/*}" && pwd -P)"
        f="$(readlink "$f")"
        case "$f" in
            /*) ;;
            *) f="$d/$f" ;;
        esac
    done
    cd "${f%/*}" && pwd -P
}

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        log_err "$1 is not installed"
        exit 3
    fi
}

# 改 settings.json。mode=check 只做只读校验与可写性探针，不落任何盘。
# 解析不了、或目录不可写，都在产生副作用之前退出。
write_statusline() {
    local mode="${1:-write}" settings="${2:-$CLAUDE_SETTINGS}" cmd="${3:-$CC_CMD_NAME}"
    CLAUDE_SETTINGS="$settings" CC_CMD_NAME="$cmd" WREN_MODE="$mode" python3 - <<'PY'
import json, os, shutil, sys

path = os.environ["CLAUDE_SETTINGS"]
cmd = os.environ["CC_CMD_NAME"]
mode = os.environ["WREN_MODE"]
parent = os.path.dirname(path) or "."


def fail(msg):
    sys.stderr.write("wren: %s\n" % msg)
    sys.exit(1)


data = {}
backup = None
if os.path.exists(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read().strip()
    except OSError as exc:
        fail("cannot read %s: %s" % (path, exc.strerror or exc))
    if raw:
        try:
            data = json.loads(raw)
        except ValueError as exc:
            fail("%s is not valid JSON, refusing to touch it: %s" % (path, exc))
    if not isinstance(data, dict):
        fail("%s top level is not an object, refusing to touch it" % path)

if mode == "check":
    # 可写性探针：真到 write 阶段才发现不可写的话，那会儿已经装了一半
    if os.path.isdir(parent):
        probe = os.path.join(parent, ".wren-write-probe")
        try:
            with open(probe, "w", encoding="utf-8") as fh:
                fh.write("")
        except OSError as exc:
            fail("cannot write in %s: %s" % (parent, exc.strerror or exc))
        try:
            os.unlink(probe)
        except OSError:
            pass
    sys.exit(0)

try:
    if parent and not os.path.isdir(parent):
        os.makedirs(parent, exist_ok=True)
    # 只在第一次安装时留底，保住 wren 介入前的原始状态
    cand = path + ".wren-bak"
    if os.path.exists(path) and not os.path.exists(cand):
        shutil.copy2(path, cand)
        backup = cand

    # 只动 statusLine 这一个键，其余键与其顺序原样保留
    sl = data.get("statusLine")
    if not isinstance(sl, dict):
        sl = {}
    sl["type"] = "command"
    sl["command"] = cmd
    data["statusLine"] = sl

    tmp = path + ".wren-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
except OSError as exc:
    fail("cannot write %s: %s" % (path, exc.strerror or exc))
print(backup or "")
PY
}

# 只在 statusLine 确实指向本工具时才删，避免抹掉用户自己的配置
clear_statusline() {
    local settings="${1:-$CLAUDE_SETTINGS}" cmd="${2:-$CC_CMD_NAME}"
    [[ -f "$settings" ]] || return 0
    CLAUDE_SETTINGS="$settings" CC_CMD_NAME="$cmd" python3 - <<'PY'
import json, os, sys

path = os.environ["CLAUDE_SETTINGS"]
cmd = os.environ["CC_CMD_NAME"]
try:
    with open(path, "r", encoding="utf-8") as fh:
        raw = fh.read().strip()
except OSError:
    sys.exit(0)
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except ValueError:
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
sl = data.get("statusLine")
if not isinstance(sl, dict) or sl.get("command") != cmd:
    print("leftalone")
    sys.exit(0)
del data["statusLine"]
try:
    tmp = path + ".wren-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
except OSError:
    sys.exit(0)
PY
}

# install_payload <src> <target> <label> [exec]
install_payload() {
    local src="$1" target="$2" label="$3" want_exec="${4:-}"
    local dir="${target%/*}"

    if [[ ! -f "$src" ]]; then
        log_err "$label payload not found: $src"
        exit 3
    fi
    if [[ ! -d "$dir" ]]; then
        if ! mkdir -p "$dir" 2>/dev/null; then
            log_err "cannot create $dir"
            exit 1
        fi
    fi
    # 目标位置上若已有别的东西，说一声再覆盖，不默默抹掉。
    # 软链先解引用再比内容（指向相同内容的不吵，指到别处的会吵）
    if [[ -e "$target" || -L "$target" ]]; then
        local probe="$target"
        [[ -L "$probe" ]] && probe="$(readlink -f "$probe" 2>/dev/null || echo "")"
        if [[ -n "$probe" && -f "$probe" ]] && ! cmp -s "$probe" "$src"; then
            log_err "[$label] warning: $target already exists and differs; replacing it"
        fi
        if ! rm -f "$target" 2>/dev/null; then
            log_err "cannot remove existing $target"
            exit 1
        fi
    fi
    if ! cp "$src" "$target" 2>/dev/null; then
        log_err "cannot install $target"
        exit 1
    fi
    if [[ -n "$want_exec" ]]; then
        chmod +x "$target" 2>/dev/null || true
    fi
    log_info "[$label] installed $target"
}

# remove_payload <target> <src> <label>
# 只删「确实是本工具装的」那份：内容与 payload 一致（拷入的副本），
# 或仍是指向 payload 的软链（兼容软链装法留下的旧状态）。被改过的一律不动。
remove_payload() {
    local target="$1" src="$2" label="$3"
    if [[ ! -e "$target" && ! -L "$target" ]]; then
        log_info "[$label] $target does not exist; nothing to do"
        return 0
    fi
    if [[ -L "$target" && "$(readlink "$target")" == "$src" ]]; then
        rm -f "$target" && log_info "[$label] removed $target"
    elif [[ -f "$target" && ! -L "$target" ]] && cmp -s "$target" "$src"; then
        rm -f "$target" && log_info "[$label] removed $target"
    else
        log_info "[$label] $target is not ours; left alone"
    fi
}

cmd_install() {
    local target="$1"
    local dir cc_payload pi_payload qc_payload backup
    dir="$(script_dir)"
    cc_payload="$dir/wren.py"
    pi_payload="$dir/wren.ts"
    qc_payload="$dir/wren-qc.py"

    # 前置校验全部先行：任一要写配置的宿主读不懂/写不进，连一个 payload 都不装
    # （否则 all 场景下 cc/pi 装完才发现 qc 配置写不进，留半装状态）
    if want_target "$target" cc; then
        require_cmd python3
        if ! write_statusline check >/dev/null; then
            exit 1
        fi
    fi
    if want_target "$target" qc; then
        require_cmd python3
        if ! write_statusline check "$QODER_SETTINGS" "$QC_CMD" >/dev/null; then
            exit 1
        fi
    fi

    if want_target "$target" cc; then
        install_payload "$cc_payload" "$PREFIX/$CC_CMD_NAME" "cc" exec
        if ! backup="$(write_statusline write)"; then
            exit 1
        fi
        if [[ -n "$backup" ]]; then
            log_info "[cc] backed up $CLAUDE_SETTINGS -> $backup"
        fi
        log_info "[cc] statusLine -> $CC_CMD_NAME"
    fi

    if want_target "$target" pi; then
        install_payload "$pi_payload" "$PI_EXT_DIR/wren.ts" "pi"
        # 旧的手工部署副本仍叫 odo.ts；pi 会把两个 footer 都装上，提前说清楚
        if [[ -e "$PI_EXT_DIR/odo.ts" || -L "$PI_EXT_DIR/odo.ts" ]]; then
            log_err "[pi] warning: legacy $PI_EXT_DIR/odo.ts still exists; pi will load both footers"
            log_err "[pi]          remove it if wren should be the only one"
        fi
    fi

    if want_target "$target" qc; then
        install_payload "$qc_payload" "$QC_CMD" "qc" exec
        if ! backup="$(write_statusline write "$QODER_SETTINGS" "$QC_CMD")"; then
            exit 1
        fi
        if [[ -n "$backup" ]]; then
            log_info "[qc] backed up $QODER_SETTINGS -> $backup"
        fi
        log_info "[qc] statusLine -> $QC_CMD"
    fi

    log_info "done. run 'wren uninstall' to undo."
}

cmd_uninstall() {
    local target="$1"
    local dir cc_payload pi_payload qc_payload sidecar
    dir="$(script_dir)"
    cc_payload="$dir/wren.py"
    pi_payload="$dir/wren.ts"
    qc_payload="$dir/wren-qc.py"

    if want_target "$target" pi; then
        remove_payload "$PI_EXT_DIR/wren.ts" "$pi_payload" "pi"
    fi

    if want_target "$target" qc; then
        remove_payload "$QC_CMD" "$qc_payload" "qc"

        if command -v python3 >/dev/null 2>&1; then
            if [[ "$(clear_statusline "$QODER_SETTINGS" "$QC_CMD")" == "leftalone" ]]; then
                log_info "[qc] statusLine does not point at $QC_CMD; left alone"
            else
                log_info "[qc] statusLine removed"
            fi
        else
            log_err "[qc] python3 not found; $QODER_SETTINGS not touched"
        fi

        for sidecar in "$QODER_SETTINGS.wren-bak" "$QODER_SETTINGS.wren-tmp"; do
            [[ -e "$sidecar" ]] || continue
            if rm -f "$sidecar" 2>/dev/null; then
                log_info "[qc] removed $sidecar"
            else
                log_err "[qc] cannot remove $sidecar"
            fi
        done
    fi

    if want_target "$target" cc; then
        remove_payload "$PREFIX/$CC_CMD_NAME" "$cc_payload" "cc"

        if command -v python3 >/dev/null 2>&1; then
            if [[ "$(clear_statusline)" == "leftalone" ]]; then
                log_info "[cc] statusLine does not point at $CC_CMD_NAME; left alone"
            else
                log_info "[cc] statusLine removed"
            fi
        else
            log_err "[cc] python3 not found; $CLAUDE_SETTINGS not touched"
        fi

        # 清掉 cc 侧的副产物：安装时留的备份，以及写失败可能残留的临时文件
        for sidecar in "$CLAUDE_SETTINGS.wren-bak" "$CLAUDE_SETTINGS.wren-tmp"; do
            [[ -e "$sidecar" ]] || continue
            if rm -f "$sidecar" 2>/dev/null; then
                log_info "[cc] removed $sidecar"
            else
                log_err "[cc] cannot remove $sidecar"
            fi
        done
    fi

    log_info "done."
}

# 目标选择：all 两者都做，cc / pi 各只做一侧
want_target() {
    local target="$1" want="$2"
    [[ "$target" == "all" || "$target" == "$want" ]]
}

# 归一化并校验 target；非法则 exit 2。
# 不能在 $(...) 里调用——那会跑在子 shell，exit 2 只退出子 shell，
# 主流程拿到空串继续当 all 跑（第一版踩过这个坑）。
normalize_target() {
    case "${1:-all}" in
        all) TARGET=all ;;
        cc|claude) TARGET=cc ;;
        pi) TARGET=pi ;;
        qc|qoder) TARGET=qc ;;
        *)
            log_err "unsupported target: $1"
            usage >&2
            exit 2
            ;;
    esac
}

main() {
    if [[ $# -lt 1 ]]; then
        usage >&2
        exit 2
    fi

    PREFIX="${PREFIX:-/usr/local/bin}"
    PI_EXT_DIR="${PI_EXT_DIR:-$HOME/.pi/agent/extensions}"
    # Claude Code 支持用 CLAUDE_CONFIG_DIR 重定向配置目录（ccstatusline 也读它），
    # 默认值要跟着走，否则在那类机器上会把 settings 写进错误的 ~/.claude
    local claude_cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    CLAUDE_SETTINGS="${CLAUDE_SETTINGS:-$claude_cfg/settings.json}"
    # qoder 同理：QODER_CONFIG_DIR 是 qoder 官方的重定向变量；statusLine.command 写绝对路径
    local qoder_cfg="${QODER_CONFIG_DIR:-$HOME/.qoder}"
    QODER_SETTINGS="${QODER_SETTINGS:-$qoder_cfg/settings.json}"
    QC_CMD="$qoder_cfg/wren-qc.py"
    TARGET=all

    case "$1" in
        install)   normalize_target "${2:-}"; cmd_install "$TARGET" ;;
        uninstall) normalize_target "${2:-}"; cmd_uninstall "$TARGET" ;;
        -h|--help) usage; exit 0 ;;
        *)
            log_err "unsupported command: $1"
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
