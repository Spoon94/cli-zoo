#!/usr/bin/env bash
# wren - 把 statusline 装到 Claude Code 与 pi 两个宿主上。
#
# 布局:
#   行1: ~/cwd | branch ↑a↓b +增 ~删 ✱改
#   行2: ↑in ↓out R cacheR CH% CPn | ctx%/win | 模型名 · 思考等级 · 时长
#
# 本目录内三个 payload 拷出去安装:
#   wren-cc.py -> <settings.json 同目录>/wren-cc   并在 settings.json 写入 statusLine（绝对路径）
#   wren-pi.ts -> $PI_EXT_DIR/wren-pi.ts        pi 自动加载该目录下的 .ts
#   wren-qc.py -> $QODER_CONFIG_DIR/wren-qc.py 并在 ~/.qoder/settings.json 写入 statusLine（绝对路径）
#
# 装的是副本而不是软链：装完以后不依赖本仓库是否还在原处。
#
# 用法:
#   wren install [cc|pi|all]
#   wren uninstall [cc|pi|all]
#   wren -h

set -u

# cc 部署目标：与 settings.json 同目录的 wren-cc（绝对路径；v8 起不再放 $PREFIX，
# 与 qc 侧一致：command 写绝对路径，且重定向 settings 就重定向了 payload）

usage() {
    cat <<'EOF'
Usage: wren <command> [target]

将本目录下的 statusline payload 装到四个宿主:

  wren-cc.py ->  <settings.json 同目录>/wren-cc  并在 $CLAUDE_SETTINGS 写入 statusLine（绝对路径）
  wren-pi.ts ->  $PI_EXT_DIR/wren-pi.ts          pi 自动加载该目录下的 .ts
  wren-qc.py ->  $QODER_CONFIG_DIR/wren-qc.py  并在 $QODER_SETTINGS 写入 statusLine（command 写绝对路径，与 qoder 官方引导一致）
  wren-oc.tsx + wren-oc-core.ts ->  <tui.json 同目录>/plugins/  并在 $OPENCODE_TUI_CONFIG 的 plugin 数组里加 "./plugins/wren-oc.tsx"

Commands:
  install [target]     安装（幂等）。装的是文件副本，装完不依赖本仓库位置
  uninstall [target]   卸载（只删自己装的那份，被改过的不动；一并清掉自己的副产物）
  -h, --help           显示本帮助

target（省略则为 all）:
  all                  四个宿主都装（默认）
  cc                   只装 Claude Code 侧（别名 claude）
  pi                   只装 pi 侧
  qc                   只装 Qoder CLI 侧（别名 qoder）
  oc                   只装 opencode 侧（别名 opencode）

Environment:
  PI_EXT_DIR         pi 扩展目录 (default: $HOME/.pi/agent/extensions)
  CLAUDE_SETTINGS    要改的 settings.json  (default: $CLAUDE_CONFIG_DIR/settings.json,
                     未设则 $HOME/.claude/settings.json)
  QODER_CONFIG_DIR   Qoder CLI 配置目录 (default: $HOME/.qoder；qoder 官方同名变量)
  QODER_SETTINGS     要改的 Qoder settings.json (default: $QODER_CONFIG_DIR/settings.json)
  OPENCODE_CONFIG_DIR  opencode 配置目录 (default: $XDG_CONFIG_HOME/opencode，未设则 $HOME/.config/opencode)
  OPENCODE_TUI_CONFIG  要改的 opencode TUI 配置 (default: $OPENCODE_CONFIG_DIR/tui.json；
                     已存在的 tui.jsonc 会被优先接管)

依赖:
  装 cc / qc / oc 时需要 python3（合并写 settings.json / 补 tui.json 的 plugin 数组）；只装 pi 时不需要。

退出码:
  0  成功
  1  写入失败（settings.json / tui.json 读不懂、目标不可写等）
  2  参数错误（未知子命令、未知 target）
  3  依赖缺失（python3，或 payload 文件不存在）
EOF
}

log_err() {
    printf '%s\n' "$*" >&2
}

log_info() {
    printf '%s\n' "$*"
}

# 回溯脚本自身位置（可能被 cli-zoo-install.sh 软链到 $PREFIX），借此找到同目录的 payload。
# 只用 bash 内建与 readlink，不依赖 dirname/pwd 这些外部命令。
script_dir() {
    local f="${BASH_SOURCE[0]}" d
    while [[ -L "$f" ]]; do
        d="$(cd "${f%/*}" && pwd -P)"
        f="$(readlink "$f")"
        case "$f" in
            /*) ;;
            *) f="$d/$f" ;;
        esac
    done
    cd "${f%/*}" && pwd -P
}

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        log_err "$1 is not installed"
        exit 3
    fi
}

# 改 settings.json。mode=check 只做只读校验与可写性探针，不落任何盘。
# 解析不了、或目录不可写，都在产生副作用之前退出。
write_statusline() {
    local mode="${1:-write}" settings="${2:-$CLAUDE_SETTINGS}" cmd="${3:-$CC_CMD}"
    CLAUDE_SETTINGS="$settings" WREN_CC_CMD="$cmd" WREN_MODE="$mode" python3 - <<'PY'
import json, os, shutil, sys

path = os.environ["CLAUDE_SETTINGS"]
cmd = os.environ["WREN_CC_CMD"]
mode = os.environ["WREN_MODE"]
parent = os.path.dirname(path) or "."


def fail(msg):
    sys.stderr.write("wren: %s\n" % msg)
    sys.exit(1)


data = {}
backup = None
if os.path.exists(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read().strip()
    except OSError as exc:
        fail("cannot read %s: %s" % (path, exc.strerror or exc))
    if raw:
        try:
            data = json.loads(raw)
        except ValueError as exc:
            fail("%s is not valid JSON, refusing to touch it: %s" % (path, exc))
    if not isinstance(data, dict):
        fail("%s top level is not an object, refusing to touch it" % path)

if mode == "check":
    # 可写性探针：真到 write 阶段才发现不可写的话，那会儿已经装了一半。
    # parent 不存在时不能直接跳过（那正是半装缺口的来源：check 放行 → payload
    # 先装 → makedirs 失败 → exit 1），向上找第一个存在的祖先探它的可写性；
    # write 阶段真要 makedirs 的正是这位祖先的后代
    probe_dir = parent
    while probe_dir and not os.path.isdir(probe_dir):
        nxt = os.path.dirname(probe_dir)
        if nxt == probe_dir:
            break
        probe_dir = nxt
    if os.path.isdir(probe_dir):
        probe = os.path.join(probe_dir, ".wren-write-probe")
        try:
            with open(probe, "w", encoding="utf-8") as fh:
                fh.write("")
        except OSError as exc:
            fail("cannot write in %s: %s" % (probe_dir, exc.strerror or exc))
        try:
            os.unlink(probe)
        except OSError:
            pass
    sys.exit(0)

try:
    if parent and not os.path.isdir(parent):
        os.makedirs(parent, exist_ok=True)
    # 只在第一次安装时留底，保住 wren 介入前的原始状态
    cand = path + ".wren-bak"
    if os.path.exists(path) and not os.path.exists(cand):
        shutil.copy2(path, cand)
        backup = cand

    # 只动 statusLine 这一个键，其余键与其顺序原样保留
    sl = data.get("statusLine")
    if not isinstance(sl, dict):
        sl = {}
    sl["type"] = "command"
    sl["command"] = cmd
    data["statusLine"] = sl

    tmp = path + ".wren-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
except OSError as exc:
    fail("cannot write %s: %s" % (path, exc.strerror or exc))
print(backup or "")
PY
}

# 只在 statusLine 确实指向本工具时才删，避免抹掉用户自己的配置
clear_statusline() {
    local settings="${1:-$CLAUDE_SETTINGS}" cmd="${2:-$CC_CMD}"
    [[ -f "$settings" ]] || return 0
    CLAUDE_SETTINGS="$settings" WREN_CC_CMD="$cmd" python3 - <<'PY'
import json, os, sys

path = os.environ["CLAUDE_SETTINGS"]
cmd = os.environ["WREN_CC_CMD"]
try:
    with open(path, "r", encoding="utf-8") as fh:
        raw = fh.read().strip()
except OSError:
    sys.exit(0)
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except ValueError:
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
sl = data.get("statusLine")
if not isinstance(sl, dict) or sl.get("command") != cmd:
    print("leftalone")
    sys.exit(0)
del data["statusLine"]
try:
    tmp = path + ".wren-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(data, fh, indent=2, ensure_ascii=False)
        fh.write("\n")
    os.replace(tmp, path)
except OSError:
    sys.exit(0)
PY
}

# 改 opencode 的 tui.json(c)：只在 plugin 数组里加/删自己那一条，其余字节原样保留。
# 不调 json.loads/dump —— JSONC 的注释与排版必须留着（opencode 自己也用 jsonc-parser 做定向编辑）。
# mode=check 时只读校验 + 可写性探针，不落盘。
oc_plugin_config() {
    local mode="${1:-check}" config="${2:-$OC_TUI_CONFIG}" spec="${3:-$OC_SPEC}"
    WREN_OC_CONFIG="$config" WREN_OC_SPEC="$spec" WREN_MODE="$mode" python3 - <<'PY'
import os, shutil, sys

path = os.environ["WREN_OC_CONFIG"]
spec = os.environ["WREN_OC_SPEC"]
mode = os.environ["WREN_MODE"]
quoted = '"%s"' % spec
parent = os.path.dirname(path) or "."


def fail(msg):
    sys.stderr.write("wren: %s\n" % msg)
    sys.exit(1)


def skip_ws_comments(s, i):
    """跳过空白、`//` 行注释与 `/* */` 块注释。"""
    n = len(s)
    while i < n:
        ch = s[i]
        if ch in " \t\r\n":
            i += 1
        elif ch == "/" and i + 1 < n and s[i + 1] == "/":
            j = s.find("\n", i)
            i = n if j < 0 else j + 1
        elif ch == "/" and i + 1 < n and s[i + 1] == "*":
            j = s.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            break
    return i


def skip_string(s, i):
    """s[i] == '"'；返回闭合引号的下一位。"""
    i += 1
    n = len(s)
    while i < n:
        if s[i] == "\\":
            i += 2
            continue
        if s[i] == '"':
            return i + 1
        i += 1
    return i


def close_of(s, i, open_ch, close_ch):
    """s[i] == open_ch；返回配对的 close_ch 下标（跳过字符串/注释）。"""
    depth = 0
    n = len(s)
    while i < n:
        i = skip_ws_comments(s, i)
        if i >= n:
            break
        ch = s[i]
        if ch == '"':
            i = skip_string(s, i)
            continue
        if ch == open_ch:
            depth += 1
            i += 1
            continue
        if ch == close_ch:
            depth -= 1
            if depth == 0:
                return i
            i += 1
            continue
        i += 1
    return -1


def root_close(s):
    """根对象 `}` 的下标；不是对象 / 未闭合返回 -1。"""
    i = skip_ws_comments(s, 0)
    if i >= len(s) or s[i] != "{":
        return -1
    return close_of(s, i, "{", "}")


def value_pos(s, key):
    """顶层 `"key"` 的 value 起始下标；没有则 None。"""
    i = skip_ws_comments(s, 0)
    if i >= len(s) or s[i] != "{":
        return None
    i += 1
    depth = 1
    n = len(s)
    while i < n:
        i = skip_ws_comments(s, i)
        if i >= n:
            return None
        ch = s[i]
        if ch == '"':
            start = i
            end = skip_string(s, i)
            j = skip_ws_comments(s, end)
            if depth == 1 and s[start + 1:end - 1] == key and j < n and s[j] == ":":
                return skip_ws_comments(s, j + 1)
            i = end
            continue
        if ch in "{[":
            depth += 1
            i += 1
            continue
        if ch in "}]":
            depth -= 1
            i += 1
            continue
        i += 1
    return None


def normalize_array_seg(seg):
    """删掉多余逗号（首逗号 / 连续逗号 / 尾逗号），其余字节原样保留。"""
    while True:
        for k, ch in enumerate(seg):
            if ch != ",":
                continue
            nxt = skip_ws_comments(seg, k + 1)
            prv = k - 1
            while prv >= 0 and seg[prv] in " \t\r\n":
                prv -= 1
            if nxt >= len(seg) or seg[nxt] in ",]" or prv < 0 or seg[prv] in "[,":
                end = k + 1
                if prv < 0:  # 首逗号：顺带吃掉后面的缩进空格，结果与删除前逐字一致
                    while end < len(seg) and seg[end] in " \t":
                        end += 1
                seg = seg[:k] + seg[end:]
                break
        else:
            return seg


def find_string(s, start, end, value):
    """在 [start, end) 里找字符串字面量 value；返回 (起, 止) 或 None。"""
    i = start
    while i < end:
        i = skip_ws_comments(s, i)
        if i >= end:
            break
        if s[i] == '"':
            e = skip_string(s, i)
            if s[i + 1:e - 1] == value:
                return (i, e)
            i = e
            continue
        i += 1
    return None


raw = ""
if os.path.exists(path):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            raw = fh.read()
    except OSError as exc:
        fail("cannot read %s: %s" % (path, exc.strerror or exc))

if mode == "check":
    if raw.strip() and root_close(raw) < 0:
        fail("%s is not a JSON object, refusing to touch it" % path)
    # 可写性探针：父目录不存在时向上找第一个存在的祖先（同 cc 侧口径）
    probe_dir = parent
    while probe_dir and not os.path.isdir(probe_dir):
        nxt = os.path.dirname(probe_dir)
        if nxt == probe_dir:
            break
        probe_dir = nxt
    if os.path.isdir(probe_dir):
        probe = os.path.join(probe_dir, ".wren-write-probe")
        try:
            with open(probe, "w", encoding="utf-8") as fh:
                fh.write("")
        except OSError as exc:
            fail("cannot write in %s: %s" % (probe_dir, exc.strerror or exc))
        try:
            os.unlink(probe)
        except OSError:
            pass
    sys.exit(0)

try:
    if mode == "remove":
        if not raw.strip():
            print("leftalone")
            sys.exit(0)
        pos = value_pos(raw, "plugin")
        close = close_of(raw, pos, "[", "]") if pos is not None and pos < len(raw) and raw[pos] == "[" else -1
        hit = find_string(raw, pos + 1, close, spec) if close > 0 else None
        if hit is None:
            print("leftalone")
            sys.exit(0)
        # 在数组内部做删除：占整行的一条连同该行一起删（pretty-print 场景逐字还原），
        # 行内写法则删 token 再清掉多余逗号；数组空则归零为 []
        seg = raw[pos + 1:close]
        ts, te = hit[0] - (pos + 1), hit[1] - (pos + 1)
        line_start = seg.rfind("\n", 0, ts) + 1
        line_end = seg.find("\n", te)
        line_end = len(seg) if line_end < 0 else line_end + 1
        if all(ch in " \t\r\n," for ch in seg[line_start:ts] + seg[te:line_end]):
            new_seg = seg[:line_start] + seg[line_end:]
        else:
            new_seg = normalize_array_seg(seg[:ts] + seg[te:])
        body = raw[:pos] + "[" + ("" if skip_ws_comments(new_seg, 0) >= len(new_seg) else new_seg) + "]" + raw[close + 1:]
        if body != raw:
            tmp = path + ".wren-tmp"
            with open(tmp, "w", encoding="utf-8") as fh:
                fh.write(body)
            os.replace(tmp, path)
        print("removed")
        sys.exit(0)

    # write
    if raw.strip():
        body = raw
        pos = value_pos(body, "plugin")
        if pos is not None and pos < len(body) and body[pos] == "[":
            close = close_of(body, pos, "[", "]")
            if close < 0:
                fail("%s has an unterminated plugin array" % path)
            if find_string(body, pos + 1, close, spec) is None:
                after = skip_ws_comments(body, pos + 1)
                lead = body[pos + 1:after]
                if after < len(body) and body[after] == "]":
                    # 空数组：直接放进去，保留原有空白
                    body = body[:after] + quoted + body[after:]
                elif "\n" in lead:
                    # 多行数组：插到首元素前的那一行，缩进对齐首元素，
                    # 卸载时整行连同行尾逗号一起删，能逐字还原
                    indent = lead[lead.rfind("\n") + 1:]
                    body = body[:after] + quoted + ",\n" + indent + body[after:]
                else:
                    body = body[:pos + 1] + quoted + ", " + body[pos + 1:]
        else:
            close = root_close(body)
            if close < 0:
                fail("%s is not a JSON object, refusing to touch it" % path)
            head, tail = body[:close], body[close:]
            stripped = head.rstrip()
            need_comma = not (stripped.endswith("{") or stripped.endswith(","))
            body = stripped + ("," if need_comma else "") + '\n  "plugin": [%s]\n' % quoted + tail
    else:
        body = '{\n  "$schema": "https://opencode.ai/tui.json",\n  "plugin": [%s]\n}\n' % quoted

    if body == raw:
        print("")
        sys.exit(0)
    backup = ""
    if raw.strip() and not os.path.exists(path + ".wren-bak"):
        shutil.copy2(path, path + ".wren-bak")
        backup = path + ".wren-bak"
    if parent and not os.path.isdir(parent):
        os.makedirs(parent, exist_ok=True)
    tmp = path + ".wren-tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(body)
    os.replace(tmp, path)
    print(backup)
    sys.exit(0)
except OSError as exc:
    fail("cannot write %s: %s" % (path, exc.strerror or exc))
PY
}

# install_payload <src> <target> <label> [exec]
install_payload() {
    local src="$1" target="$2" label="$3" want_exec="${4:-}"
    local dir="${target%/*}"

    if [[ ! -f "$src" ]]; then
        log_err "$label payload not found: $src"
        exit 3
    fi
    if [[ ! -d "$dir" ]]; then
        if ! mkdir -p "$dir" 2>/dev/null; then
            log_err "cannot create $dir"
            exit 1
        fi
    fi
    # 目标位置上若已有别的东西，说一声再覆盖，不默默抹掉。
    # 软链先解引用再比内容（指向相同内容的不吵，指到别处的会吵）
    if [[ -e "$target" || -L "$target" ]]; then
        local probe="$target"
        [[ -L "$probe" ]] && probe="$(readlink -f "$probe" 2>/dev/null || echo "")"
        if [[ -n "$probe" && -f "$probe" ]] && ! cmp -s "$probe" "$src"; then
            log_err "[$label] warning: $target already exists and differs; replacing it"
        fi
        if ! rm -f "$target" 2>/dev/null; then
            log_err "cannot remove existing $target"
            exit 1
        fi
    fi
    if ! cp "$src" "$target" 2>/dev/null; then
        log_err "cannot install $target"
        exit 1
    fi
    if [[ -n "$want_exec" ]]; then
        chmod +x "$target" 2>/dev/null || true
    fi
    log_info "[$label] installed $target"
}

# remove_payload <target> <src> <label>
# 只删「确实是本工具装的」那份：内容与 payload 一致（拷入的副本），
# 或仍是指向 payload 的软链（兼容软链装法留下的旧状态）。被改过的一律不动。
remove_payload() {
    local target="$1" src="$2" label="$3"
    if [[ ! -e "$target" && ! -L "$target" ]]; then
        log_info "[$label] $target does not exist; nothing to do"
        return 0
    fi
    if [[ -L "$target" && "$(readlink "$target")" == "$src" ]]; then
        rm -f "$target" && log_info "[$label] removed $target"
    elif [[ -f "$target" && ! -L "$target" ]] && cmp -s "$target" "$src"; then
        rm -f "$target" && log_info "[$label] removed $target"
    else
        log_info "[$label] $target is not ours; left alone"
    fi
}

cmd_install() {
    local target="$1"
    local dir cc_payload pi_payload qc_payload oc_payload oc_core backup
    dir="$(script_dir)"
    cc_payload="$dir/wren-cc.py"
    pi_payload="$dir/wren-pi.ts"
    qc_payload="$dir/wren-qc.py"
    oc_payload="$dir/wren-oc.tsx"
    oc_core="$dir/wren-oc-core.ts"

    # 前置校验全部先行：任一要写配置的宿主读不懂/写不进，连一个 payload 都不装
    # （否则 all 场景下 cc/pi 装完才发现 qc 配置写不进，留半装状态）
    if want_target "$target" cc; then
        require_cmd python3
        if ! write_statusline check >/dev/null; then
            exit 1
        fi
    fi
    if want_target "$target" qc; then
        require_cmd python3
        if ! write_statusline check "$QODER_SETTINGS" "$QC_CMD" >/dev/null; then
            exit 1
        fi
    fi
    if want_target "$target" oc; then
        require_cmd python3
        if ! oc_plugin_config check >/dev/null; then
            exit 1
        fi
    fi

    if want_target "$target" cc; then
        install_payload "$cc_payload" "$CC_CMD" "cc" exec
        if ! backup="$(write_statusline write "$CLAUDE_SETTINGS" "$CC_CMD")"; then
            exit 1
        fi
        if [[ -n "$backup" ]]; then
            log_info "[cc] backed up $CLAUDE_SETTINGS -> $backup"
        fi
        log_info "[cc] statusLine -> $CC_CMD"
        # v8 迁移：旧目标 $PREFIX/wren-cc 是我们装的副本（python 脚本含 wren 指纹），
        # 留在 PATH 上会与 ~/.claude/wren-cc 并存，删掉
        local legacy="$PREFIX/wren-cc"
        if [[ -e "$legacy" || -L "$legacy" ]]; then
            if grep -q "wren" "$legacy" 2>/dev/null; then
                rm -f "$legacy" && log_info "[cc] migrated: removed legacy $legacy"
            else
                log_err "[cc] warning: $legacy exists and is not a wren payload; left alone"
            fi
        fi
    fi

    if want_target "$target" pi; then
        install_payload "$pi_payload" "$PI_EXT_DIR/wren-pi.ts" "pi"
        # v7 改名迁移：旧目标名 wren.ts 是我们自己装的副本，与新 payload 并存
        # 会让 pi 同时加载两个 footer。识别为 wren 系（首行注释特征）就删掉。
        local legacy="$PI_EXT_DIR/wren.ts"
        if [[ -e "$legacy" || -L "$legacy" ]]; then
            if grep -q "wren" "$legacy" 2>/dev/null; then
                rm -f "$legacy" && log_info "[pi] migrated: removed legacy $legacy"
            else
                log_err "[pi] warning: $legacy exists and is not a wren payload; left alone"
            fi
        fi
        # 旧的手工部署副本仍叫 odo.ts；pi 会把两个 footer 都装上，提前说清楚
        if [[ -e "$PI_EXT_DIR/odo.ts" || -L "$PI_EXT_DIR/odo.ts" ]]; then
            log_err "[pi] warning: legacy $PI_EXT_DIR/odo.ts still exists; pi will load both footers"
            log_err "[pi]          remove it if wren should be the only one"
        fi
    fi

    if want_target "$target" qc; then
        install_payload "$qc_payload" "$QC_CMD" "qc" exec
        if ! backup="$(write_statusline write "$QODER_SETTINGS" "$QC_CMD")"; then
            exit 1
        fi
        if [[ -n "$backup" ]]; then
            log_info "[qc] backed up $QODER_SETTINGS -> $backup"
        fi
        log_info "[qc] statusLine -> $QC_CMD"
    fi

    if want_target "$target" oc; then
        install_payload "$oc_payload" "$OC_CMD" "oc"
        install_payload "$oc_core" "$OC_CORE" "oc"
        if ! backup="$(oc_plugin_config write)"; then
            exit 1
        fi
        if [[ -n "$backup" ]]; then
            log_info "[oc] backed up $OC_TUI_CONFIG -> $backup"
        fi
        log_info "[oc] $OC_TUI_CONFIG plugin += $OC_SPEC"
    fi

    log_info "done. run 'wren uninstall' to undo."
}

cmd_uninstall() {
    local target="$1"
    local dir cc_payload pi_payload qc_payload oc_payload oc_core sidecar
    dir="$(script_dir)"
    cc_payload="$dir/wren-cc.py"
    pi_payload="$dir/wren-pi.ts"
    qc_payload="$dir/wren-qc.py"
    oc_payload="$dir/wren-oc.tsx"
    oc_core="$dir/wren-oc-core.ts"

    if want_target "$target" oc; then
        remove_payload "$OC_CMD" "$oc_payload" "oc"
        remove_payload "$OC_CORE" "$oc_core" "oc"

        if command -v python3 >/dev/null 2>&1; then
            if [[ "$(oc_plugin_config remove)" == "leftalone" ]]; then
                log_info "[oc] $OC_TUI_CONFIG plugin does not list $OC_SPEC; left alone"
            else
                log_info "[oc] $OC_TUI_CONFIG plugin -= $OC_SPEC"
            fi
        else
            log_err "[oc] python3 not found; $OC_TUI_CONFIG not touched"
        fi

        for sidecar in "$OC_TUI_CONFIG.wren-bak" "$OC_TUI_CONFIG.wren-tmp"; do
            [[ -e "$sidecar" ]] || continue
            if rm -f "$sidecar" 2>/dev/null; then
                log_info "[oc] removed $sidecar"
            else
                log_err "[oc] cannot remove $sidecar"
            fi
        done
    fi

    if want_target "$target" pi; then
        remove_payload "$PI_EXT_DIR/wren-pi.ts" "$pi_payload" "pi"
    fi

    if want_target "$target" qc; then
        remove_payload "$QC_CMD" "$qc_payload" "qc"

        if command -v python3 >/dev/null 2>&1; then
            if [[ "$(clear_statusline "$QODER_SETTINGS" "$QC_CMD")" == "leftalone" ]]; then
                log_info "[qc] statusLine does not point at $QC_CMD; left alone"
            else
                log_info "[qc] statusLine removed"
            fi
        else
            log_err "[qc] python3 not found; $QODER_SETTINGS not touched"
        fi

        for sidecar in "$QODER_SETTINGS.wren-bak" "$QODER_SETTINGS.wren-tmp"; do
            [[ -e "$sidecar" ]] || continue
            if rm -f "$sidecar" 2>/dev/null; then
                log_info "[qc] removed $sidecar"
            else
                log_err "[qc] cannot remove $sidecar"
            fi
        done
    fi

    if want_target "$target" cc; then
        remove_payload "$CC_CMD" "$cc_payload" "cc"
        # v8 迁移残留：老版本装过 $PREFIX/wren-cc，uninstall 一并清（指纹校验）
        local legacy="$PREFIX/wren-cc"
        if [[ -e "$legacy" || -L "$legacy" ]] && grep -q "wren" "$legacy" 2>/dev/null; then
            rm -f "$legacy" && log_info "[cc] migrated: removed legacy $legacy"
        fi

        if command -v python3 >/dev/null 2>&1; then
            if [[ "$(clear_statusline)" == "leftalone" ]]; then
                log_info "[cc] statusLine does not point at $CC_CMD; left alone"
            else
                log_info "[cc] statusLine removed"
            fi
        else
            log_err "[cc] python3 not found; $CLAUDE_SETTINGS not touched"
        fi

        # 清掉 cc 侧的副产物：安装时留的备份，以及写失败可能残留的临时文件
        for sidecar in "$CLAUDE_SETTINGS.wren-bak" "$CLAUDE_SETTINGS.wren-tmp"; do
            [[ -e "$sidecar" ]] || continue
            if rm -f "$sidecar" 2>/dev/null; then
                log_info "[cc] removed $sidecar"
            else
                log_err "[cc] cannot remove $sidecar"
            fi
        done
    fi

    log_info "done."
}

# 目标选择：all 全做，cc / pi / qc / oc 各只做一侧
want_target() {
    local target="$1" want="$2"
    [[ "$target" == "all" || "$target" == "$want" ]]
}

# 归一化并校验 target；非法则 exit 2。
# 不能在 $(...) 里调用——那会跑在子 shell，exit 2 只退出子 shell，
# 主流程拿到空串继续当 all 跑（第一版踩过这个坑）。
normalize_target() {
    case "${1:-all}" in
        all) TARGET=all ;;
        cc|claude) TARGET=cc ;;
        pi) TARGET=pi ;;
        qc|qoder) TARGET=qc ;;
        oc|opencode) TARGET=oc ;;
        *)
            log_err "unsupported target: $1"
            usage >&2
            exit 2
            ;;
    esac
}

main() {
    if [[ $# -lt 1 ]]; then
        usage >&2
        exit 2
    fi

    PREFIX="${PREFIX:-/usr/local/bin}"
    PI_EXT_DIR="${PI_EXT_DIR:-$HOME/.pi/agent/extensions}"
    # Claude Code 支持用 CLAUDE_CONFIG_DIR 重定向配置目录（ccstatusline 也读它），
    # 默认值要跟着走，否则在那类机器上会把 settings 写进错误的 ~/.claude
    local claude_cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    CLAUDE_SETTINGS="${CLAUDE_SETTINGS:-$claude_cfg/settings.json}"
    # qoder 同理：QODER_CONFIG_DIR 是 qoder 官方的重定向变量；statusLine.command 写绝对路径
    local qoder_cfg="${QODER_CONFIG_DIR:-$HOME/.qoder}"
    QODER_SETTINGS="${QODER_SETTINGS:-$qoder_cfg/settings.json}"
    QC_CMD="$qoder_cfg/wren-qc.py"
    # payload 与 settings 同目录：CLAUDE_SETTINGS 是唯一开关，重定向它就
    # 完全沙箱化（此前从 CLAUDE_CONFIG_DIR 派生，只改 SETTINGS 时会漏到真实 ~/.claude）
    case "$CLAUDE_SETTINGS" in
        */*) CC_CMD="${CLAUDE_SETTINGS%/*}/wren-cc" ;;
        *)   CC_CMD="$claude_cfg/wren-cc" ;;
    esac
    # opencode 侧：OPENCODE_CONFIG_DIR 是官方重定向变量；TUI 配置是 tui.json(c)（两个文件
    # 都会被宿主读并合并）。payload 放配置文件旁的 plugins/，spec 写相对路径（宿主按声明它的
    # 配置文件解析相对路径）。已存在的 tui.jsonc 优先接管——那是用户手写的那个，
    # 不自己新建 tui.json 去跟它抢（宿主自己的写入器用的是 tui.json）。
    local oc_cfg="${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"
    if [[ -n "${OPENCODE_TUI_CONFIG:-}" ]]; then
        OC_TUI_CONFIG="$OPENCODE_TUI_CONFIG"
    elif [[ ! -e "$oc_cfg/tui.json" && -e "$oc_cfg/tui.jsonc" ]]; then
        OC_TUI_CONFIG="$oc_cfg/tui.jsonc"
    else
        OC_TUI_CONFIG="$oc_cfg/tui.json"
    fi
    case "$OC_TUI_CONFIG" in
        */*) OC_DIR="${OC_TUI_CONFIG%/*}" ;;
        *)   OC_DIR="$oc_cfg" ;;
    esac
    OC_SPEC="./plugins/wren-oc.tsx"
    OC_CMD="$OC_DIR/plugins/wren-oc.tsx"
    OC_CORE="$OC_DIR/plugins/wren-oc-core.ts"
    TARGET=all

    case "$1" in
        install)   normalize_target "${2:-}"; cmd_install "$TARGET" ;;
        uninstall) normalize_target "${2:-}"; cmd_uninstall "$TARGET" ;;
        -h|--help) usage; exit 0 ;;
        *)
            log_err "unsupported command: $1"
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
